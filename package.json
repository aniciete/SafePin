    "eslint-plugin-prettier": "^5.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "vite": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
